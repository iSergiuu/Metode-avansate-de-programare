<Window x:Class="MusicPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Music Player" Height="650" Width="900" Background="#161b22">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1c2128" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <DockPanel Margin="15,0">
                <TextBlock Text="🎵 Music Player" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="↶ Undo" Command="{Binding UndoCommand}" Margin="5" Padding="10,2" Background="#21262d" Foreground="White"/>
                    <Button Content="↷ Redo" Command="{Binding RedoCommand}" Margin="5" Padding="10,2" Background="#21262d" Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="5">
                <TextBlock Text="LIBRARY" Foreground="#8b949e" FontWeight="Bold" FontSize="10" Margin="0,0,0,10"/>
                <ListView ItemsSource="{Binding Playlist.Tracks}" Height="250" Background="#0d1117" BorderBrush="#30363d" Foreground="White">
                </ListView>

                <TextBlock Text="PLAYBACK MODE" Foreground="#8b949e" FontWeight="Bold" FontSize="10" Margin="0,15,0,5"/>
                <StackPanel>
                    <RadioButton Content="Sequential" IsChecked="True" Foreground="White" Margin="0,2"/>
                    <RadioButton Content="Shuffle" Foreground="White" Margin="0,2" Command="{Binding ChangeToShuffleCommand}"/>
                    <RadioButton Content="Smart Shuffle" Foreground="White" Margin="0,2"/>
                </StackPanel>

                <TextBlock Text="STATISTICS" Foreground="#8b949e" FontWeight="Bold" FontSize="10" Margin="0,20,0,5"/>
                <Border Background="#0d1117" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.TotalPlayed, StringFormat='Total played: {0}'}" Foreground="White"/>
                        <TextBlock Text="{Binding Stats.TopArtist, StringFormat='Top Artist: {0}'}" Foreground="White"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="15,5,5,5">
                <TextBlock Text="NOW PLAYING" Foreground="#8b949e" FontWeight="Bold" FontSize="10" Margin="0,0,0,10"/>
                <Border Background="#1c2128" Padding="20" CornerRadius="10" Height="220">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="120" Height="120" Background="Gray" CornerRadius="5" Margin="0,0,0,15"/>
                        <TextBlock Text="{Binding Player.CurrentTrack.Title, FallbackValue='No Track'}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Player.CurrentTrack.Artist, FallbackValue='Select a song'}" Foreground="#8b949e" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="HISTORY" Foreground="#8b949e" FontWeight="Bold" FontSize="10" Margin="0,20,0,5"/>
                <ItemsControl ItemsSource="{Binding HistoryList}">
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,1,0,0">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="⏮" Width="30" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="▶" Command="{Binding PlayCommand}" Width="40" Height="40" Margin="5" Background="#1f6feb" Foreground="White" FontSize="20"/>
                    <Button Content="⏸" Command="{Binding PauseCommand}" Width="40" Height="40" Margin="5" Background="#21262d" Foreground="White" FontSize="20"/>
                    <Button Content="⏭" Width="30" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <Slider Minimum="0" Maximum="100" Background="#30363d"/>
                    <DockPanel LastChildFill="False" Margin="0,5,0,0">
                        <TextBlock Text="00:00" Foreground="#8b949e" FontSize="10"/>
                        <TextBlock Text="00:00" Foreground="#8b949e" FontSize="10" DockPanel.Dock="Right"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔊" Foreground="White" Margin="0,0,10,0"/>
                    <Slider Width="100" Value="{Binding Player.Volume, Mode=TwoWay}" Minimum="0" Maximum="1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>